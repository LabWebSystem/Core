#!/usr/bin/env bash
set -Eeuo pipefail

VERSION_FILE="${LWS_VERSION_FILE:-/usr/share/lws/version}"
INSTALLER_PATH="${LWS_INSTALLER_PATH:-/usr/share/lws/install.sh}"
CONFIG_DIR="${LWS_CONFIG_DIR:-/etc/lws}"
STATE_DIR="${LWS_STATE_DIR:-/var/lib/lws}"
COMPOSE_FILE="${LWS_COMPOSE_FILE:-/usr/share/lws/compose.yaml}"
PROJECT="${LWS_COMPOSE_PROJECT:-lws}"
CONFIG_FILE="$CONFIG_DIR/config.env"

usage() { cat >&2 <<'EOF'
使い方: lwsctl <start|stop|status|rebuild|update|uninstall> [オプション]

start     [--domain ドメイン] [--force]
uninstall [--purge] [--force]
EOF
}
die() { printf 'lwsctl: %s\n' "$*" >&2; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "必要なコマンドが見つかりません: $1"; }
[[ -r "$VERSION_FILE" ]] || die "LWSバージョンファイルを読み取れません: $VERSION_FILE"
VERSION="$(<"$VERSION_FILE")"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "LWSバージョンが不正です: $VERSION"

valid_domain() {
  [[ "$1" =~ ^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?[a-z0-9]*)+$ ]]
}
compose() {
  require_command docker
  [[ -f "$COMPOSE_FILE" ]] || die "Composeファイルが見つかりません: $COMPOSE_FILE"
  docker compose --project-name "$PROJECT" --file "$COMPOSE_FILE" "$@"
}
load_config() {
  [[ -f "$CONFIG_FILE" ]] || return 1
  # config.envはこのスクリプトが生成したシェル安全な値だけを含みます。
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  [[ -n "${LWS_BASE_DOMAIN:-}" ]] || die "LWSの設定が不正です"
  export LWS_BASE_DOMAIN LWS_VERSION
}
write_config() {
  local domain="$1"
  install -d -m 0755 "$CONFIG_DIR" "$STATE_DIR"
  printf 'LWS_BASE_DOMAIN=%q\nLWS_VERSION=%q\n' "$domain" "$VERSION" >"$CONFIG_FILE"
  chmod 0644 "$CONFIG_FILE"
  export LWS_BASE_DOMAIN="$domain" LWS_VERSION="$VERSION"
}
confirm() {
  local prompt="$1" answer
  read -r -p "$prompt [y/N]: " answer || true
  [[ "$answer" == "y" || "$answer" == "Y" || "$answer" == "yes" || "$answer" == "YES" ]]
}

start() {
  local requested="" force=0
  while (($#)); do
    case "$1" in
      -d|--domain) (($# >= 2)) || die "--domainには値が必要です"; requested="$2"; shift 2 ;;
      -f|--force) force=1; shift ;;
      *) die "startの不明なオプションです: $1" ;;
    esac
  done
  if [[ -n "$requested" ]] && ! valid_domain "$requested"; then die "ドメインが不正です: $requested"; fi
  if load_config; then
    local current="$LWS_BASE_DOMAIN"
    if [[ -n "$requested" && "$requested" != "$current" ]]; then
      if (( ! force )) && ! confirm "ベースドメインを$currentから$requestedへ変更し、ルーティング設定を再生成します。続行しますか?"; then
        die "ドメインの変更をキャンセルしました"
      fi
      write_config "$requested"
      export LWS_BASE_DOMAIN="$requested"
    fi
  else
    if [[ -z "$requested" ]]; then read -r -p 'ベースドメイン: ' requested; fi
    [[ -n "$requested" ]] || die "ベースドメインが必要です"
    valid_domain "$requested" || die "ドメインが不正です: $requested"
    write_config "$requested"
  fi
  compose up -d --remove-orphans
  printf 'LWSを%s向けに起動しました\n' "${LWS_BASE_DOMAIN:-$requested}"
}
stop() {
  [[ -f "$COMPOSE_FILE" ]] || { printf 'LWSはインストールされていません\n'; return 0; }
  load_config || true
  compose down --remove-orphans
  printf 'LWSを停止しました\n'
}
status() {
  [[ -f "$CONFIG_FILE" ]] && load_config && printf '設定済み: YES\nドメイン: %s\n' "$LWS_BASE_DOMAIN" || printf '設定済み: NO\n'
  [[ -f "$COMPOSE_FILE" ]] || { printf '実行環境: 未インストール\n'; return 0; }
  compose ps
}
rebuild() {
  load_config || die '設定を作成するため、先にstartを実行してください'
  compose config >/dev/null
  compose up -d --force-recreate --remove-orphans
  printf 'LWSを再構成しました\n'
}
update() {
  load_config || die '設定を作成するため、先にstartを実行してください'
  if [[ "${LWS_SKIP_PACKAGE_UPDATE:-0}" != 1 ]]; then
    [[ -x "$INSTALLER_PATH" ]] || die "インストーラーが見つかりません: $INSTALLER_PATH"
    env -u LWS_VERSION "$INSTALLER_PATH"
    exec env LWS_SKIP_PACKAGE_UPDATE=1 "$0" update
  fi
  write_config "$LWS_BASE_DOMAIN"
  compose pull
  compose up -d --remove-orphans
  printf 'LWSを更新しました\n'
}
uninstall() {
  local purge=0 force=0
  while (($#)); do
    case "$1" in
      --purge) purge=1; shift ;;
      -f|--force) force=1; shift ;;
      *) die "uninstallの不明なオプションです: $1" ;;
    esac
  done
  if (( purge )); then
    (( force )) || confirm "LWSの設定と永続データを削除します。続行しますか?" || die '完全削除をキャンセルしました'
  fi
  stop || true
  if (( purge )); then rm -rf -- "$CONFIG_DIR" "$STATE_DIR"; fi
  local manager=''
  if command -v apt-get >/dev/null 2>&1; then manager=apt-get; elif command -v dnf >/dev/null 2>&1; then manager=dnf; fi
  if [[ -n "$manager" && "${LWS_SKIP_PACKAGE_REMOVE:-0}" != 1 ]]; then
    "$manager" remove -y lws
  else
    printf 'パッケージマネージャーによる削除をスキップしました（有効にするにはLWS_SKIP_PACKAGE_REMOVE=0を設定してください）。\n'
  fi
}
main() {
  (($#)) || { usage; exit 2; }
  case "$1" in
    start) shift; start "$@" ;;
    stop) shift; (($# == 0)) || die 'stopにはオプションを指定できません'; stop ;;
    status) shift; (($# == 0)) || die 'statusにはオプションを指定できません'; status ;;
    rebuild) shift; (($# == 0)) || die 'rebuildにはオプションを指定できません'; rebuild ;;
    update) shift; (($# == 0)) || die 'updateにはオプションを指定できません'; update ;;
    uninstall) shift; uninstall "$@" ;;
    *) usage; exit 2 ;;
  esac
}
main "$@"
