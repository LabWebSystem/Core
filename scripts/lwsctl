#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="0.1.0"
CONFIG_DIR="${LWS_CONFIG_DIR:-/etc/lws}"
STATE_DIR="${LWS_STATE_DIR:-/var/lib/lws}"
COMPOSE_FILE="${LWS_COMPOSE_FILE:-/usr/share/lws/compose.yaml}"
PROJECT="${LWS_COMPOSE_PROJECT:-lws}"
CONFIG_FILE="$CONFIG_DIR/config.env"

usage() { cat >&2 <<'EOF'
Usage: lwsctl <start|stop|status|rebuild|update|uninstall> [options]

start     [--domain DOMAIN] [--force]
uninstall [--purge] [--force]
EOF
}
die() { printf 'lwsctl: %s\n' "$*" >&2; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

valid_domain() {
  [[ "$1" =~ ^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?[a-z0-9]*)+$ ]]
}
compose() {
  require_command docker
  [[ -f "$COMPOSE_FILE" ]] || die "Compose file not found: $COMPOSE_FILE"
  docker compose --project-name "$PROJECT" --file "$COMPOSE_FILE" "$@"
}
load_config() {
  [[ -f "$CONFIG_FILE" ]] || return 1
  # config.env is generated by this script and contains only shell-safe values.
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  [[ -n "${LWS_BASE_DOMAIN:-}" ]] || die "invalid LWS configuration"
  export LWS_BASE_DOMAIN
}
write_config() {
  local domain="$1"
  install -d -m 0755 "$CONFIG_DIR" "$STATE_DIR"
  printf 'LWS_BASE_DOMAIN=%q\nLWS_VERSION=%q\n' "$domain" "$VERSION" >"$CONFIG_FILE"
  chmod 0644 "$CONFIG_FILE"
}
confirm() {
  local prompt="$1" answer
  read -r -p "$prompt [y/N]: " answer || true
  [[ "$answer" == "y" || "$answer" == "Y" || "$answer" == "yes" || "$answer" == "YES" ]]
}

start() {
  local requested="" force=0
  while (($#)); do
    case "$1" in
      -d|--domain) (($# >= 2)) || die "--domain requires a value"; requested="$2"; shift 2 ;;
      -f|--force) force=1; shift ;;
      *) die "unknown start option: $1" ;;
    esac
  done
  if [[ -n "$requested" ]] && ! valid_domain "$requested"; then die "invalid domain: $requested"; fi
  if load_config; then
    local current="$LWS_BASE_DOMAIN"
    if [[ -n "$requested" && "$requested" != "$current" ]]; then
      if (( ! force )) && ! confirm "Changing base domain from $current to $requested will regenerate routing settings. Continue?"; then
        die "domain change cancelled"
      fi
      write_config "$requested"
      export LWS_BASE_DOMAIN="$requested"
    fi
  else
    if [[ -z "$requested" ]]; then read -r -p 'Base domain: ' requested; fi
    [[ -n "$requested" ]] || die "a base domain is required"
    valid_domain "$requested" || die "invalid domain: $requested"
    write_config "$requested"
  fi
  compose up -d --remove-orphans
  printf 'LWS started for %s\n' "${LWS_BASE_DOMAIN:-$requested}"
}
stop() {
  [[ -f "$COMPOSE_FILE" ]] || { printf 'LWS is not installed\n'; return 0; }
  compose down --remove-orphans
  printf 'LWS stopped\n'
}
status() {
  [[ -f "$CONFIG_FILE" ]] && load_config && printf 'configured: yes\ndomain: %s\n' "$LWS_BASE_DOMAIN" || printf 'configured: no\n'
  [[ -f "$COMPOSE_FILE" ]] || { printf 'runtime: not installed\n'; return 0; }
  compose ps
}
rebuild() {
  load_config || die 'run start first to create configuration'
  compose config >/dev/null
  compose up -d --force-recreate --remove-orphans
  printf 'LWS rebuilt\n'
}
update() {
  load_config || die 'run start first to create configuration'
  compose pull
  compose up -d --remove-orphans
  printf 'LWS updated\n'
}
uninstall() {
  local purge=0 force=0
  while (($#)); do
    case "$1" in
      --purge) purge=1; shift ;;
      -f|--force) force=1; shift ;;
      *) die "unknown uninstall option: $1" ;;
    esac
  done
  if (( purge )); then
    (( force )) || confirm "This removes LWS configuration and persistent data. Continue?" || die 'purge cancelled'
  fi
  stop || true
  if (( purge )); then rm -rf -- "$CONFIG_DIR" "$STATE_DIR"; fi
  local manager=''
  if command -v apt-get >/dev/null 2>&1; then manager=apt-get; elif command -v dnf >/dev/null 2>&1; then manager=dnf; fi
  if [[ -n "$manager" && "${LWS_SKIP_PACKAGE_REMOVE:-0}" != 1 ]]; then
    "$manager" remove -y lws
  else
    printf 'Package manager removal skipped (set LWS_SKIP_PACKAGE_REMOVE=0 to enable).\n'
  fi
}
main() {
  (($#)) || { usage; exit 2; }
  case "$1" in
    start) shift; start "$@" ;;
    stop) shift; (($# == 0)) || die 'stop takes no options'; stop ;;
    status) shift; (($# == 0)) || die 'status takes no options'; status ;;
    rebuild) shift; (($# == 0)) || die 'rebuild takes no options'; rebuild ;;
    update) shift; (($# == 0)) || die 'update takes no options'; update ;;
    uninstall) shift; uninstall "$@" ;;
    *) usage; exit 2 ;;
  esac
}
main "$@"
