Name: lws
Version: VERSION
Release: 1%{?dist}
Summary: LabWebSystemのライフサイクルツール
License: MIT
BuildArch: noarch
%description
LabWebSystemのライフサイクルCLIとDocker Compose定義です。
%prep
%build
%install
mkdir -p %{buildroot}/usr/bin %{buildroot}/usr/share/lws
install -m 0755 %{_sourcedir}/lwsctl %{buildroot}/usr/bin/lwsctl
install -m 0644 %{_sourcedir}/compose.yaml %{buildroot}/usr/share/lws/compose.yaml
install -m 0644 %{_sourcedir}/version %{buildroot}/usr/share/lws/version
install -m 0755 %{_sourcedir}/install.sh %{buildroot}/usr/share/lws/install.sh
%preun
if [ "$1" -eq 0 ] && [ -x /usr/bin/lwsctl ]; then
  LWS_SKIP_PACKAGE_REMOVE=1 /usr/bin/lwsctl stop || :
fi
%files
/usr/bin/lwsctl
/usr/share/lws/compose.yaml
/usr/share/lws/version
/usr/share/lws/install.sh
